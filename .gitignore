# Dependencies
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
.eggs/

# Build outputs
dist/
out/
release/
/build/
*.AppImage
*.deb

# PyInstaller
dist/bridge-bin/
/tmp/ci-pyinstaller/

# Environment
.env
.env.*

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# App runtime data (user profiles — never commit real data)
Chrome/
Isolated-Chrome/

# Secrets / cookies
*.cookie
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Temp
tmp/
.tmp/

# Markdown (keep only README)
*.md
!README.md
# Documentation that is part of the shipped image/scripts
!scripts/docker/HOST-SPOOFING.md
# Runtime data — per-user, must never be committed
/profiles.json
/proxies.json
/.empty
/icon.png
# Chromium auto-update runtime state (written by backend/chromium_version.py)
/chromium-version-check.json
# ...including the .tmp siblings an interrupted atomic write can leave behind
/chromium-version-check.json.*.tmp

# Migration backups and runtime state
/profiles.json.bak-*
/image-update-state.json
/image-update.lock
